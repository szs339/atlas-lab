---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Publication from '../components/Publication.astro';
import NewsItem from '../components/NewsItem.astro';
import { data, settings, href, copy, themeLabels } from '../lib/site.mjs';

const projects = data.projects.filter(p => p.featured).slice(0, settings.featuredProjectLimit);
const papers = data.publications.filter(p => p.featured).slice(0, settings.selectedPublicationLimit);
const news = data.news.slice(0, settings.recentNewsLimit);
---
<Layout>
  <section class="hero"><div class="container hero-content">
    <h1>{copy.home.title}<br />{' '}<em>{copy.home.accent}</em></h1>
    <p class="lead">{settings.intro}</p>
    <div class="actions"><a class="button" href={href('/projects/')}>{copy.home.projectsButton} <span aria-hidden="true">→</span></a><a class="text-link" href={href('/opportunities/')}>{copy.home.thesisLink}</a></div>
  </div></section>
  <div class="container">
    <section class="section"><div class="section-heading"><div><p class="eyebrow">{copy.home.themesEyebrow}</p><h2>{copy.home.themesTitle}</h2></div></div>
      <div class="theme-grid">{Object.entries(themeLabels).map(([key, name], i) => <article><span class="theme-number">0{i + 1}</span><h3>{name}</h3><p>{copy.themes[`${key}Description`]}</p></article>)}</div>
    </section>
    <section class="section"><div class="section-heading"><div><p class="eyebrow">{copy.home.projectsEyebrow}</p><h2>{copy.home.projectsTitle}</h2></div><a class="text-link" href={href('/projects/')}>{copy.home.allProjects} →</a></div><div class="project-grid">{projects.map(p => <ProjectCard project={p} />)}</div></section>
    <section class="section home-updates"><div><div class="section-heading"><h2>{copy.home.newsTitle}</h2><a href={href('/news/')}>{copy.home.allNews} →</a></div>{news.length ? news.map(item => <NewsItem item={item} />) : <p class="empty">{copy.home.newsEmpty}</p>}</div><div><div class="section-heading"><h2>{copy.home.publicationsTitle}</h2><a href={href('/publications/')}>{copy.home.allPublications} →</a></div>{papers.length ? papers.map(p => <Publication paper={p} />) : <p class="empty">{copy.home.publicationsEmpty}</p>}</div></section>
    <section class="thesis-banner"><div><p class="eyebrow">{copy.home.thesisEyebrow}</p><h2>{copy.home.thesisTitle}</h2><p>{copy.home.thesisIntro}</p></div><a class="button light" href={href('/opportunities/')}>{copy.home.thesisButton} →</a></section>
  </div>
</Layout>
