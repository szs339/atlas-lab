---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Publication from '../components/Publication.astro';
import NewsItem from '../components/NewsItem.astro';
import { data, settings, href, copy } from '../lib/site.mjs';

const director = data.people.find(p => p.id === settings.directorId)!;
const expansionParts = settings.expansion.match(/^(.*?)\s+(Learning and Systems)$/i);
const projects = data.projects.filter(p => p.featured).slice(0, settings.featuredProjectLimit);
const papers = data.publications.filter(p => p.featured).slice(0, settings.selectedPublicationLimit);
const news = data.news.filter(item => item.featured).slice(0, settings.recentNewsLimit);
---
<Layout>
  <section class="hero home-hero" aria-labelledby="lab-name">
    {settings.heroImage && <img class="hero-art" src={href(settings.heroImage)} alt="" aria-hidden="true" decoding="async" />}
    <div class="container hero-content profile-intro">
      <div class="director-profile">
        {director.photo && <img class="director-portrait" src={href(director.photo)} alt={director.photoAlt} width="240" height="280" fetchpriority="high" />}
        <h1 id="director-name">{director.name}</h1>
        <p class="profile-role">{director.role}</p>
        {director.position && <p class="profile-affiliation">{director.position}</p>}
        <p class="profile-lab-role">{copy.home.directorLabel}, {settings.title}</p>
      </div>
      <div class="lab-profile">
        <div class="lab-intro">
          <h2 id="lab-name">{settings.title}</h2>
          <p class="lab-expansion">{expansionParts ? <><span>{expansionParts[1]}</span>{' '}<em>{expansionParts[2]}</em></> : settings.expansion}</p>
          <p class="lead">{settings.intro}</p>
        </div>
        <div class="actions">
          <a class="button" href={href('/projects/')}>{copy.home.projectsButton} <span aria-hidden="true">→</span></a>
          {settings.cvPath && <a class="text-link profile-link" href={href(settings.cvPath)} download>{copy.home.cvButton}</a>}
          <a class="text-link profile-link" href={`mailto:${settings.email}`}>{copy.home.contactButton}</a>
        </div>
      </div>
    </div>
  </section>
  <div class="container home-content">
    <section class="section"><div class="section-heading"><h2>{copy.home.projectsTitle}</h2><a class="text-link" href={href('/projects/')}>{copy.home.allProjects} →</a></div><div class="project-grid">{projects.map(p => <ProjectCard project={p} showStatus={false} />)}</div></section>
    <section class="section home-updates"><div><div class="section-heading"><h2>{copy.home.newsTitle}</h2><a href={href('/news/')}>{copy.home.allNews} →</a></div>{news.length ? news.map(item => <NewsItem item={item} />) : <p class="empty">{copy.home.newsEmpty}</p>}</div><div><div class="section-heading"><h2>{copy.home.publicationsTitle}</h2><a href={href('/publications/')}>{copy.home.allPublications} →</a></div>{papers.length ? papers.map(p => <Publication paper={p} />) : <p class="empty">{copy.home.publicationsEmpty}</p>}</div></section>
  </div>
</Layout>
