---
import { href, copy, themeLabels } from '../lib/site.mjs';

const { project, showStatus = true } = Astro.props;
---
<article class="project-card" data-filter-item data-theme={project.theme} data-status={project.status} data-search={`${project.title} ${project.expansion} ${project.summary}`}>
  <div class="card-top"><span class="eyebrow">{themeLabels[project.theme]}</span>{showStatus && <span class="status">{copy.projects[project.status]}</span>}</div>
  <h3><a href={href(`/projects/${project.slug}/`)}>{project.title}</a></h3>
  <p>{project.summary}</p>
  <a class="text-link" href={href(`/projects/${project.slug}/`)}>{copy.projects.explore} <span aria-hidden="true">→</span></a>
</article>
